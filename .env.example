# Storage (optional — without this, memory + file fallback)
DATABASE_URL=

# Cron protection (required in production)
CRON_SECRET=

# Auction — aT nationwide (preferred) or garak (immediate)
# 같은 키로 해수부 위판장(수산 경락가 원천)도 조회한다:
#   해양수산부_위판장별 위탁판매 현황 — data.go.kr/data/15056856
DATA_GO_KR_SERVICE_KEY=
GARAK_API_ID=
GARAK_API_PW=
GARAK_AUCTION_DATAID=

# KAMIS — baseline + retail
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Naver 쇼핑 검색 API — 온라인 소매가 채널 (선택)
# 발급: https://developers.naver.com/apps — '검색' API 사용 신청
# 크롤링이 아니라 공식 Open API를 사용한다 (일 25,000회 한도)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional
DEFAULT_MARKET_CODE=110001
BASELINE_WINDOW_DAYS=30

# ── 트래픽 · SEO · 분석 ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vegi-wang.vercel.app
# Vercel Analytics / Speed Insights는 대시보드+패키지로 활성화 (코드에 포함됨)
# GA4 측정 ID (선택) — https://analytics.google.com → 관리 → 데이터 스트림
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# 구글 서치콘솔 HTML 태그 인증값 (meta content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 HTML 태그 인증값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# 네이버 프리미엄로그분석(선택) wa ID
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
