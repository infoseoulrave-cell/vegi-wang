# Storage — prefer Supabase Session pooler (IPv4) over direct db.* host
# postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Cron protection (required in production)
CRON_SECRET=

# Auction — aT nationwide (preferred) or garak (immediate)
DATA_GO_KR_SERVICE_KEY=
GARAK_API_ID=
GARAK_API_PW=
GARAK_AUCTION_DATAID=

# KAMIS — baseline + retail
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Optional
DEFAULT_MARKET_CODE=110001
BASELINE_WINDOW_DAYS=30
